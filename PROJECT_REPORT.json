{
  "project": {
    "name": "AI-Powered Question Paper Generator & Exam Management System",
    "version": "3.0.0",
    "description": "A comprehensive web application that generates intelligent question papers from PDF documents and manages complete exam workflows using Google Gemini AI technology",
    "type": "Full-Stack Web Application",
    "status": "Production Ready",
    "created": "2024",
    "last_updated": "December 2025"
  },
  
  "overview": {
    "purpose": "Transform educational content into comprehensive question papers and manage complete exam workflows with AI-powered assistance",
    "target_audience": [
      "Educational Institutions",
      "Teachers and Educators",
      "Students",
      "Training Organizations",
      "Content Creators"
    ],
    "key_benefits": [
      "Automated question generation from PDF documents",
      "AI-powered answer verification and scoring",
      "Complete exam management system",
      "Real-time student monitoring",
      "Comprehensive analytics and reporting",
      "Modern, responsive user interface",
      "Role-based access control"
    ]
  },

  "tech_stack": {
    "frontend": {
      "framework": "React 18.2.0",
      "language": "JavaScript (ES6+)",
      "routing": "React Router DOM 6.3.0",
      "styling": {
        "primary": "Tailwind CSS 3.3.0",
        "approach": "Utility-first CSS with custom premium design",
        "features": [
          "Glass morphism effects",
          "Gradient backgrounds",
          "Smooth animations",
          "Responsive design",
          "Dark/light theme support"
        ]
      },
      "ui_components": {
        "icons": "Lucide React 0.263.1",
        "file_upload": "React Dropzone 14.2.3",
        "http_client": "Axios 1.4.0"
      },
      "build_tools": [
        "React Scripts 5.0.1",
        "PostCSS 8.4.24",
        "Autoprefixer 10.4.14"
      ]
    },
    
    "backend": {
      "framework": "Flask 2.3.3",
      "language": "Python 3.8+",
      "architecture": "RESTful API with microservices pattern",
      "core_libraries": [
        "Flask-CORS 4.0.0",
        "Flask-SQLAlchemy 3.0.5",
        "Flask-JWT-Extended 4.5.2",
        "Flask-Bcrypt 1.0.1",
        "Flask-SocketIO 5.3.6"
      ],
      "ai_integration": {
        "primary_ai": "Google Gemini AI",
        "model": "gemini-2.5-flash",
        "library": "google-generativeai 0.3.2",
        "fallback_system": "Local AI templates and keyword matching"
      },
      "file_processing": [
        "PyPDF2 3.0.1",
        "ReportLab 4.0.4",
        "Pillow 10.0.0"
      ],
      "data_analysis": [
        "Pandas 2.1.1",
        "Matplotlib 3.7.2",
        "Seaborn 0.12.2"
      ]
    },

    "database": {
      "type": "SQLite (Development) / PostgreSQL (Production)",
      "orm": "SQLAlchemy",
      "features": [
        "User management",
        "Exam storage",
        "Answer tracking",
        "Performance analytics",
        "Session management"
      ]
    },

    "deployment": {
      "frontend": "Netlify / Vercel compatible",
      "backend": "Railway / Heroku compatible",
      "containerization": "Docker ready",
      "environment": "Environment variable configuration"
    }
  },

  "system_architecture": {
    "pattern": "Client-Server Architecture with AI Integration",
    "components": {
      "presentation_layer": {
        "technology": "React SPA",
        "responsibilities": [
          "User interface rendering",
          "State management",
          "Client-side routing",
          "Form validation",
          "Real-time updates"
        ]
      },
      "api_layer": {
        "technology": "Flask REST API",
        "responsibilities": [
          "Request handling",
          "Authentication & authorization",
          "Business logic processing",
          "Data validation",
          "AI service integration"
        ]
      },
      "ai_services": {
        "technology": "Google Gemini AI",
        "responsibilities": [
          "Question generation",
          "Answer verification",
          "Content analysis",
          "Study material creation",
          "Chat assistance"
        ]
      },
      "data_layer": {
        "technology": "SQLAlchemy ORM",
        "responsibilities": [
          "Data persistence",
          "Query optimization",
          "Transaction management",
          "Data integrity"
        ]
      }
    }
  },

  "features": {
    "core_features": [
      {
        "name": "AI Question Generation",
        "description": "Generate diverse questions from PDF documents using Gemini AI",
        "technologies": ["Google Gemini AI", "PyPDF2", "Natural Language Processing"],
        "question_types": ["Multiple Choice", "True/False", "Short Answer", "Essay Questions"],
        "difficulty_levels": ["Easy", "Medium", "Hard"],
        "customization": "Topic-based, difficulty-based, and format-based generation"
      },
      {
        "name": "Exam Management System",
        "description": "Complete workflow for creating, assigning, and managing exams",
        "features": [
          "Exam creation with multiple question types",
          "Student assignment and tracking",
          "Real-time exam monitoring",
          "Automated scoring and feedback",
          "Performance analytics"
        ]
      },
      {
        "name": "User Authentication & Authorization",
        "description": "Secure role-based access control system",
        "roles": ["Admin/Teacher", "Student"],
        "security": ["JWT tokens", "Bcrypt password hashing", "Session management"],
        "features": ["Registration", "Login", "Password reset", "Profile management"]
      },
      {
        "name": "AI Study Assistant",
        "description": "Interactive chatbot for educational support",
        "capabilities": [
          "Topic-based study material generation",
          "Question answering",
          "Learning guidance",
          "Concept explanations"
        ]
      },
      {
        "name": "Analytics & Reporting",
        "description": "Comprehensive performance tracking and visualization",
