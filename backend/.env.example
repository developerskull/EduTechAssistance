# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///exam_system.db
# DATABASE_URL=postgresql://edutech_user:edutech_pass@localhost:5432/edutech_db

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-pro

# Server Configuration
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Upload Configuration
MAX_CONTENT_LENGTH=10485760  # 10 MB in bytes
UPLOAD_FOLDER=uploads

