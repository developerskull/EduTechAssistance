          "Student performance trends",
          "Exam completion rates",
          "Score distributions",
          "Participation analytics"
        ],
        "visualizations": ["Charts", "Graphs", "Progress bars", "Statistical summaries"]
      }
    ],

    "advanced_features": [
      {
        "name": "Real-time Communication",
        "description": "Live updates and notifications using WebSocket",
        "capabilities": ["Instant exam assignments", "Live student tracking", "Real-time notifications"]
      },
      {
        "name": "PDF Processing & RAG",
        "description": "Advanced document processing with Retrieval-Augmented Generation",
        "features": ["Text extraction", "Content chunking", "Context understanding", "Semantic analysis"]
      },
      {
        "name": "Responsive Design",
        "description": "Mobile-first design with premium UI/UX",
        "features": ["Glass morphism", "Gradient themes", "Smooth animations", "Cross-device compatibility"]
      }
    ]
  },

  "workflow": {
    "user_registration_flow": [
      "User visits landing page",
      "Selects registration option",
      "Chooses role (Teacher/Student)",
      "Fills registration form",
      "Account verification",
      "Redirected to role-specific dashboard"
    ],

    "question_generation_flow": [
      "Teacher uploads PDF document",
      "System extracts and processes text",
      "AI analyzes content and context",
      "Gemini AI generates diverse questions",
      "Questions are formatted and validated",
      "Results presented to teacher for review",
      "Questions can be edited or regenerated"
    ],

    "exam_management_flow": [
      "Teacher creates exam with questions",
      "Assigns exam to selected students",
      "Students receive notifications",
      "Students take exam with timer",
      "AI verifies answers in real-time",
      "Automatic scoring and feedback",
      "Results stored and analytics updated",
      "Performance reports generated"
    ],

    "ai_integration_flow": [
      "User input received",
      "Request preprocessed and validated",
      "Gemini AI API called with structured prompt",
      "AI response processed and formatted",
      "Fallback system activated if AI fails",
      "Response delivered to user interface",
      "Usage metrics tracked and logged"
    ]
  },

  "file_structure": {
    "frontend": {
      "src/": {
        "components/": [
          "LandingPage.js - Premium landing page with modern design",
          "Login.js - User authentication interface",
          "Register.js - User registration form",
          "Dashboard.js - Main dashboard router",
          "AdminDashboard.js - Teacher/admin interface",
          "StudentDashboard.js - Student interface",
          "ExamTaking.js - Exam interface with timer",
          "ExamResults.js - Results display with analytics",
          "AIQuestionGenerator.js - AI-powered question generation",
          "StudyMaterialGenerator.js - Study content creation",
          "StudyChatbot.js - Interactive AI assistant",
          "VideoQuestionGenerator.js - Video-based question generation"
        ],
        "contexts/": [
          "SimpleAuthContext.js - Authentication state management",
          "ExamContext.js - Exam state management"
        ],
        "services/": [
          "api.js - HTTP client configuration",
          "authService.js - Authentication services"
        ],
        "utils/": [
          "sampleData.js - Demo data for testing"
        ]
      }
    },

    "backend": {
      "python-backend/": {
        "app.py": "Main Flask application with all routes",
        "models.py": "Database models and schemas",
        "auth.py": "Authentication and authorization logic",
        "exam_routes.py": "Exam management endpoints",
        "answer_routes.py": "Answer submission and verification",
        "services/": [
          "gemini_ai_assistant.py - Gemini AI integration for study assistance",
          "gemini_question_generator.py - AI-powered question generation",
          "local_ai_fallback.py - Fallback system for AI failures"
        ],
        "requirements.txt": "Python dependencies",
        ".env": "Environment configuration"
      }
    }
  },

  "api_endpoints": {
    "authentication": [
      {
        "method": "POST",
        "endpoint": "/api/auth/register",
        "description": "User registration",
        "parameters": ["username", "email", "password", "role"]
      },
      {
        "method": "POST", 
        "endpoint": "/api/auth/login",
        "description": "User authentication",
        "parameters": ["username", "password"]
      }
    ],

    "question_generation": [
      {
        "method": "POST",
        "endpoint": "/api/generate-questions",
        "description": "Generate questions using AI",
        "parameters": ["topic", "description", "num_questions", "difficulty", "question_type"]
      },
      {
        "method": "POST",
        "endpoint": "/api/generate-study-content",
        "description": "Generate study materials",
        "parameters": ["topic", "file_content", "source"]
      }
    ],

    "ai_services": [
      {
        "method": "POST",
        "endpoint": "/api/chat-with-ai",
        "description": "Chat with AI assistant",
        "parameters": ["message", "context", "previous_messages"]
      }
    ],

    "exam_management": [
      {
        "method": "POST",
        "endpoint": "/api/exams/create",
        "description": "Create new exam",
        "parameters": ["title", "questions", "time_limit"]
      },
      {
        "method": "POST",
        "endpoint": "/api/exams/assign",
        "description": "Assign exam to students",
        "parameters": ["exam_id", "student_ids"]
      }
    ],

    "analytics": [
      {
        "method": "GET",
        "endpoint": "/api/dashboard/admin/stats",
        "description": "Get admin analytics",
        "response": "Student statistics, exam data, performance metrics"
      },
      {
        "method": "GET",
        "endpoint": "/api/dashboard/student/dashboard",
        "description": "Get student dashboard data",
        "response": "Assigned exams, results, progress tracking"
      }
    ]
  },

